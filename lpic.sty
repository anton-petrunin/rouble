% options

% Print nothing but the picture and labels
\def\lpopt@clean
{%
  \let\lp@lblframe=\relax%
  \let\lp@figframe=\relax%
  \let\lp@pictframe=\relax%
  \let\lp@coords=\relax%
  \let\lp@grid=\relax%
  \let\lbl=\lbl@cmd%
  \let\lp@putepsfigure=\lp@putepsfigurecmd%
}

% Set margins
\def\lpopt@l#1%
{%
  \ifthenelse{\not\equal{#1}{}}
             {\setlength{\lpmarginleft}{#1}}{}%
}
\def\lpopt@r#1%
{%
  \ifthenelse{\not\equal{#1}{}}
             {\setlength{\lpmarginright}{#1}}{}%
}
\def\lpopt@t#1%
{%
  \ifthenelse{\not\equal{#1}{}}
             {\setlength{\lpmargintop}{#1}}{}%
}
\def\lpopt@b#1%
{%
  \ifthenelse{\not\equal{#1}{}}
             {\setlength{\lpmarginbottom}{#1}}{}%
}

% Print frame around whole picture margins included
\def\lpopt@frame#1%
{%
  \ifthenelse{\not\equal{#1}{}}
             {\setlength{\lpframethickness}{#1}}{}%
\let\lp@pictframe=\lp@pictframecmd%
}

% Print frame around eps figure
\def\lpopt@figframe#1%
{%
  \ifthenelse{\not\equal{#1}{}}
             {\setlength{\lpfigframethickness}{#1}}{}%
  \let\lp@figframe=\lp@figframecmd%
}

% Draw frames around labels
\def\lpopt@frames#1%
{%
  \ifthenelse{\not\equal{#1}{}}
             {\setlength{\lplblframethickness}{#1}}{}%
  \let\lp@lblframe=\lp@lblframecmd%
}

% Write coordinates on all four sides of the picture
% argument=step
\def\lpopt@coords#1%
{%
  \ifthenelse{\not\equal{#1}{}}
             {\setcounter{lpcoordstep}{#1}}{}%
  \let\lp@coords=\lp@coordscmd%
}

% Draw a grid, argument=step
\def\lpopt@grid#1%
{%
  \ifthenelse{\not\equal{#1}{}}
             {\setcounter{lpgridstep}{#1}}{}%
  \let\lp@grid=\lp@gridcmd%
}

% Ignore all the labels
\def\lpopt@nolbl{\renewcommand{\lbl}[2][]{\relax}}

% Don't insert epsfigure
\def\lpopt@nofigure{\let\lp@putepsfigure=\relax}

% Draw what is usually convenient for adjusting the labels
\def\lpopt@draft
{%
\lpopt@figframe{}\relax%
\lpopt@frame{}\relax%
\lpopt@coords{}\relax%
\lpopt@grid{}\relax%
\lpopt@frames{}\relax%
}

% Print help
\def\lpopt@help%
{%
  \newpage
  USAGE:\\
  \texttt{$\mathtt{\backslash}$%
   begin\{lpic\}[options]\{eps\_file[(xscale[,yscale])]\}\\
   \rule{10mm}{0mm}$\mathtt{\backslash}$lbl[position]\{xcoord,ycoord[,angle];label\}\\
   \rule{10mm}{0mm}...\\
   $\backslash$end\{lpic\}}\\
  where\\
  {\tt xscale} and {\tt yscale} are decimal numbers.
  If {\tt yscale} is omitted then it is assumed equal to {\tt xscale},
  if both are omitted, then figure is not scaled.\\
  {\tt xcoord} and {\tt ycoord} are decimal numbers. These are
  coordinates in {\tt $\backslash$lpunitlength} in the original
  (unscaled) figure. Thus, if scaling factors are changed, labels
  (hopefully) stay in right places. Optional {\tt angle} is in
  degrees. Rotation would work with dvips driver and won't show in dvi
  file. You could set a script LaTeX'ing and dvips'ing TeX file
  whenever it is changed and start gv with -watch option to view the
  result correctly. Another way is to use pdflatex instead. Your pictures must
  be in pdf for this to work.\\
  {\tt position} is at most two of the letters {\tt l,r,t,b} define
  the reference point in the label box.\\
  Options are as follows. Parameter in () is optional, if
  omitted, then default value is assumed:\\
  {\tt l(length)} - adjust left margin\\
  {\tt r(length)} - adjust right margin\\
  {\tt t(length)} - adjust top margin\\
  {\tt b(length)} - adjust bottom margin\\
  {\tt grid(step)} - draw a grid of step 
        {\tt step *  $\backslash$lpunitlength}\\
  {\tt coord(step)} - draw coordinates of step 
        {\tt step *  $\backslash$lpunitlength}\\
  {\tt frames(length)} - draw frames of thickness {\tt length} 
        around labels\\
  {\tt frame(length)} - draw frame of thickness {\tt length} 
        around the whole picture\\
  {\tt figframe(length)} - draw frame of thickness {\tt length} 
        around the eps figure\\
  {\tt draft} - print whatever is convenient for adjusting label positions\\
  {\tt nolbl} - do not print labels\\
  {\tt nofigure} - do not print epsfigure\\
  {\tt help}  - print help\\
  The following parameters could be adjusted:\\
  LENGTHS:\\
  {\tt $\backslash$lpunitlength} - 
     units in the original picture. If you change it
  labels will shift!\\
  {\tt $\backslash$lpmarginright,$\backslash$lpmarginleft,
       $\backslash$lpmargintop,$\backslash$lpmarginbottom} - default
       values for margins.\\
  {\tt $\backslash$lpgridthickness, $\backslash$lpframethickness,
       $\backslash$lplblframethickness, $\backslash$lpfigframethickness}
       - default values for thickness of different kinds of lines.\\
  COUNTERS:\\
  {\tt lpgridstep,lpcoordstep} - default step for grid and coordinates\\
  TODO:\\
  1 optimise,\\ 
  2 allow to give the desired sizes instead of scale factors\\
  3 epsfig deals well with negative scale factors (flips the
  picture) -- incorporate this.\\
  4 Aloow to rotate labels by a given angle\\
  5 Negative margins?
  6 When nofigure option is given frame is also not drawn. Fix.
  \newpage
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Option processing commands
%
%

% Should be called \exec@option{name(arg)} or 
% \exec@option{name}. It executes \name and passes
% arg if present as an argument.
% That is \name should have at most one argument.

\def\exec@optionmisc#1(#2)#3ENDOFTHEARGS%
{%
  \csname#1\endcsname{#2}\relax%
}
\newcommand{\exec@option}[1]
{%
  \exec@optionmisc#1()ENDOFTHEARGS%
}


% Called with a coma-separated list of options, and then executes
% each ``name'' prefixed with the value of \option@prefix. It passes
% this command the argument if present. Each option is either
% ``name'' or ``name(arg)''. ``arg'' should not contain comas or
% should be enclosed in {}.
\def\process@optionsmisc#1,#2ENDOFTHEARGS%
{%
  %\lp@msg{1=#1, 2=#2}
  \ifthenelse{\not\equal{#1}{}}%
     {%
       \exec@option{\option@prefix#1}%
       \process@optionsmisc#2ENDOFTHEARGS%
     }%
     {}%
}
\newcommand\process@options[1]
{%
  \process@optionsmisc#1,,ENDOFTHEARGS%
}

\def\lp@getscale#1)(%
{%
  \def\lp@xscale{#1}%
  \def\lp@yscale{#1}%
}

\def\lp@getscaleandfile#1(#2,#3)(#4)#5ENDOFTHEARGS%
{%
  \def\lp@xscale{1}\def\lp@yscale{1}%
  \def\lp@epsfile{#1}%
  \ifthenelse{\equal{#2}{}}
     {%
       \def\lp@xscale{1}%
       \def\lp@yscale{1}%
     }
     {\ifthenelse{\equal{#3}{}}
         {\lp@getscale#2}
	 {%
	   \def\lp@xscale{#2}%
	   \def\lp@yscale{#3}%
	 }%
     }%
  \ifthenelse{\equal{\lp@xscale}{}}{\def\lp@xscale{1}}{}%
  \ifthenelse{\equal{}{\lp@yscale}}{\def\lp@yscale{\lp@xscale}}{}%
}
%
